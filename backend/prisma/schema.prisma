generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum MealType {
  BREAKFAST
  LUNCH
  DINNER
  SNACK
  PROTEIN_SHAKE
}

model User {
  id               String   @id @default(cuid())
  email            String   @unique
  passwordHash     String
  refreshTokenHash String?
  displayName      String?
  weightKg         Float?
  heightCm         Float?
  age              Int?
  sex              String?
  activityLevel    String?
  fitnessGoal      String?
  goalNotes        String?
  dietaryPreferences String[]
  allergies        String[]
  dislikes         String[]
  targetCalories   Int?
  targetProtein    Int?
  targetCarbs      Int?
  targetFat        Int?
  mealsPerDay      Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  meals            Meal[]
  weekPlans        WeekPlan[]
  groceryLists     GroceryList[]
  exercises        TrainingExercise[]
  trainingDays     TrainingDay[]
  workoutSessions  WorkoutSession[]
  receipts         Receipt[]
  ingredientPrices IngredientPrice[]
}

model Meal {
  id          String     @id @default(cuid())
  userId      String
  name        String
  score       Int
  categoryId  String?
  link        String?
  image       String?
  prepTime    Int?
  cookTime    Int?
  servings    Int?
  aiCategorized Boolean @default(false)
  aiNutrition Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  category    MealCategory? @relation(fields: [categoryId], references: [id])
  ingredients MealIngredient[]
  steps       MealStep[]
  nutrition   Nutrition?
  tags        MealTagOnMeal[]
  types       MealTypeOnMeal[]

  @@index([userId, createdAt])
}

model MealCategory {
  id    String @id @default(cuid())
  name  String @unique
  meals Meal[]
}

model MealTag {
  id    String @id @default(cuid())
  name  String @unique
  meals MealTagOnMeal[]
}

model MealTagOnMeal {
  mealId String
  tagId  String
  meal   Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  tag    MealTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([mealId, tagId])
}

model Ingredient {
  id    String @id @default(cuid())
  name  String @unique
  meals MealIngredient[]
  prices IngredientPrice[]
}

model MealIngredient {
  id           String @id @default(cuid())
  mealId       String
  ingredientId String
  amount       String
  unit         String
  meal         Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([mealId])
}

model MealStep {
  id      String @id @default(cuid())
  mealId  String
  orderNo Int
  text    String
  meal    Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@index([mealId, orderNo])
}

model Nutrition {
  id        String @id @default(cuid())
  mealId    String @unique
  calories  Int
  protein   Int
  carbs     Int
  fat       Int
  fiber     Int
  sugar     Int
  sodium    Int
  meal      Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)
}

model MealTypeOnMeal {
  mealId String
  type   MealType
  meal   Meal @relation(fields: [mealId], references: [id], onDelete: Cascade)

  @@id([mealId, type])
}

model WeekPlan {
  id         String   @id @default(cuid())
  userId     String
  startDate  String
  aiGenerated Boolean @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  days       DayPlan[]

  @@unique([userId, startDate])
}

model DayPlan {
  id           String @id @default(cuid())
  weekPlanId   String
  date         String
  breakfastId  String?
  lunchId      String?
  snackId      String?
  proteinShakeId String?
  dinnerId     String?
  weekPlan     WeekPlan @relation(fields: [weekPlanId], references: [id], onDelete: Cascade)

  @@unique([weekPlanId, date])
}

model GroceryList {
  id            String @id @default(cuid())
  userId        String
  weekPlanId    String
  weekStartDate String
  generatedAt   DateTime @default(now())
  user          User @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         GroceryItem[]

  @@unique([userId, weekStartDate])
  @@index([weekPlanId])
}

model GroceryItem {
  id                    String @id @default(cuid())
  groceryListId         String
  name                  String
  quantity              Float
  unit                  String
  category              String
  checked               Boolean @default(false)
  estimatedExpirationDate String?
  recommendedPurchaseDate String?
  buyByDate             String?
  urgency               String?
  notes                 String?
  forMeals              String[]
  groceryList           GroceryList @relation(fields: [groceryListId], references: [id], onDelete: Cascade)

  @@index([groceryListId, category])
}

model TrainingExercise {
  id             String   @id @default(cuid())
  userId         String
  name           String
  category       String
  muscleGroups   String[]
  equipment      String?
  difficulty     String?
  instructions   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedItems   TrainingDayExercise[]
  sessionItems   WorkoutSessionExercise[]

  @@index([userId, name])
}

model TrainingDay {
  id        String   @id @default(cuid())
  userId    String
  date      String
  status    String   @default("planned")
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercises TrainingDayExercise[]
  sessions  WorkoutSession[]

  @@unique([userId, date])
  @@index([userId, date])
}

model TrainingDayExercise {
  id            String @id @default(cuid())
  trainingDayId String
  exerciseId    String
  orderNo       Int
  sets          Int?
  reps          Int?
  durationMin   Int?
  targetWeight  Float?
  intensity     String?
  notes         String?
  trainingDay   TrainingDay      @relation(fields: [trainingDayId], references: [id], onDelete: Cascade)
  exercise      TrainingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([trainingDayId, orderNo])
}

model WorkoutSession {
  id            String   @id @default(cuid())
  userId        String
  trainingDayId String?
  date          String
  status        String   @default("completed")
  durationMin   Int?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainingDay   TrainingDay? @relation(fields: [trainingDayId], references: [id], onDelete: SetNull)
  exercises     WorkoutSessionExercise[]

  @@index([userId, date])
}

model WorkoutSessionExercise {
  id               String @id @default(cuid())
  workoutSessionId String
  exerciseId        String
  orderNo           Int
  sets              Int?
  reps              Int?
  weight            Float?
  durationMin       Int?
  notes             String?
  workoutSession    WorkoutSession   @relation(fields: [workoutSessionId], references: [id], onDelete: Cascade)
  exercise          TrainingExercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@index([workoutSessionId, orderNo])
}

model Receipt {
  id           String   @id @default(cuid())
  userId       String
  store        String   @default("Biedronka")
  imageUrl     String
  purchaseDate String
  totalAmount  Float?
  currency     String   @default("PLN")
  createdAt    DateTime @default(now())
  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  prices       IngredientPrice[]

  @@index([userId, purchaseDate])
}

model IngredientPrice {
  id           String   @id @default(cuid())
  userId       String
  ingredientId String
  receiptId    String?
  price        Float
  quantity     Float
  unit         String
  unitPrice    Float
  currency     String   @default("PLN")
  purchaseDate String
  createdAt    DateTime @default(now())
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  receipt      Receipt?   @relation(fields: [receiptId], references: [id], onDelete: SetNull)

  @@index([ingredientId, purchaseDate])
  @@index([userId, purchaseDate])
}
